<div id="<%= dom_id signature %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Name:</strong>
    <%= signature.name %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Address:</strong>
    <%= signature.address %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Message:</strong>
    <%= signature.message %>
  </div>
</div>

<%% content_for :title, t("<%= plural_table_name %>.new.title") %>

<div class="md:w-2/3 w-full">
  <h1 class="font-bold text-4xl"><%%= t("<%= plural_table_name %>.new.title") %></h1>

  <%%= render "form", <%= singular_table_name %>: @<%= singular_table_name %> %>

  <%%= link_to t("<%= plural_table_name %>.new.back"), <%= index_helper(type: :path) %>, class: "w-full sm:w-auto text-center mt-2 sm:mt-0 sm:ml-2 rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
</div>

<%% content_for :title, t("<%= plural_table_name %>.index.title") %>

<div class="w-full">
  <%% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block" id="notice"><%%= notice %></p>
  <%% end %>

  <div class="flex justify-between items-center">
    <h1 class="font-bold text-4xl"><%%= t("<%= plural_table_name %>.index.title") %></h1>
    <%%= link_to t("<%= plural_table_name %>.index.new"), new_<%= singular_route_name %>_path, class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white block font-medium" %>
  </div>

  <div id="<%= plural_table_name %>" class="min-w-full divide-y divide-gray-200 space-y-5">
    <%% if @<%= plural_table_name %>.any? %>
      <%% @<%= plural_table_name %>.each do |<%= singular_table_name %>| %>
        <div class="flex flex-col sm:flex-row justify-between items-center pb-5 sm:pb-0">
          <%%= render <%= singular_table_name %> %>
          <div class="w-full sm:w-auto flex flex-col sm:flex-row space-x-2 space-y-2">
            <%%= link_to t("common.show"), <%= singular_table_name %>, class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
            <%%= link_to t("common.edit"), edit_<%= singular_route_name %>_path(<%= singular_table_name %>), class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
            <%%= button_to t("common.delete"), <%= singular_table_name %>, method: :delete, class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 text-white bg-red-600 hover:bg-red-500 font-medium cursor-pointer", data: { turbo_confirm: t("common.are_you_sure") } %>
          </div>
        </div>
      <%% end %>
    <%% else %>
      <p class="text-center my-10"><%%= t("<%= plural_table_name %>.index.no_records") %></p>
    <%% end %>
  </div>
</div>
